<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema">

    <element name="menu">
        <complexType>
            <sequence>
                <element name="item" maxOccurs="10">
                    <complexType>
                        <sequence>
                            <element name="name" type="string"/>
                            <element name="description" type="string"/>
                            <element name="price" type="decimal"/>
                        </sequence>
                    </complexType>
                </element>
            </sequence>
        </complexType>
    </element>

</schema>